#!/bin/bash

# module for running alignment and feature counting

sum() {
	paste -sd+ - | sed 's/\+ $//' | bc
}
divide() {
	[[ "${2}" -eq 0 ]] && echo "NA" || echo "scale=5; (${1} / ${2})" | bc
}
divide_2() {
	[[ "${2}" -eq 0 ]] && echo "NA" || echo "scale=5; 1 - (${1} / ${2})" | bc
}

# parse hisat2/featurecounts summary
parse_mapping() {
	counts_file="${1}"
	counts_summary_file="${2}"
	total_reads="${3}"

	unmapped=$(grep -P "Unassigned_Unmapped" "${counts_summary_file}" | cut -f2)
	nofeatures=$(grep -P "Unassigned_NoFeatures" "${counts_summary_file}" | cut -f2)
	assigned=$(grep -P "Assigned" "${counts_summary_file}" | cut -f2)
	unassigned_lowqual=$(grep -P "Unassigned_MappingQuality" "${counts_summary_file}" | cut -f2)
	zeroes=$(cut "${counts_file}" -f 7 | grep -Pnc "^0$")
	# feature count output has 1 command header, 1 table header line, so start at line 3
	total_features=$(tail -n +3 "${counts_file}" | wc -l)
	nonzeroes=$((total_features - zeroes))
	pos_strand_count=$(cut "${counts_file}" -f 5,7 | tr -d ';-' | tr -s '+\t' '1*' | grep '^1' | sum)
	gene_length_total=$(tail -n +3 "${counts_file}" | cut -f 6,7 | grep -v "	0$" | cut -f1 | sum)

	# calculate rates
	mapping_rate=$(divide_2 "${unmapped}" "${total_reads}")
	nofeature_rate=$(divide "${nofeatures}" "${total_reads}")
	lowquality_rate=$(divide "${unassigned_lowqual}" "${total_reads}")
	sparsity=$(divide "${zeroes}" "${total_features}")
	pos_strand_rate=$(divide "${pos_strand_count}" "${assigned}")
	avg_length=$(divide "${gene_length_total}" "${nonzeroes}")
	{
		# phase 2 mapping information
		mapping_to_json "${mapping_rate}" "${nofeature_rate}" "${lowquality_rate}" "${sparsity}" "${pos_strand_rate}" "${avg_length}"
	}
}

# format a json key-value pair
# $1: key
# $2: value
json_kv() {
	KEY="${1}"
	VALUE="${2}"
	{
		printf "\"%s\": %s" "${KEY}" "${VALUE}"
	}
}

# format a json str:float pair
# $1: str key
# $2: float value
json_kv_sf() {
	KEY="${1}"
	VALUE="${2}"
	{
		if [[ "${VALUE}" == "NA" ]]; then
			printf "\"%s\": \"NaN\"" "${KEY}"
		else
			printf "\"%s\": %.5f" "${KEY}" "${VALUE}"
		fi
	}
}


# mapping info to json serialization
# $1: mapping_rate
# $2: nofeature_rate
# $3: lowqual_rate
# $4: sparsity
# $5: pos_strand_rate
# $6: avg_gene_size
mapping_to_json() {
	{
		printf "{"
		json_kv_sf "mapping_rate" "${1}"
		printf ","
		json_kv_sf "nofeature_rate" "${2}"
		printf ","
		json_kv_sf "lowqual_rate" "${3}"
		printf ","
		json_kv_sf "sparsity" "${4}"
		printf ","
		json_kv_sf "pos_strand_rate" "${5}"
		printf ","
		json_kv_sf "avg_gene_size" "${6}"
		printf "}"
	}
}

mapping_main() {
	set -e
	shopt -s inherit_errexit
	FASTQ="${1}"
	HISAT2_INDEX="${2}"
	GTF="${3}"
	OUTFILE="${4:-/dev/stdout}"
	THREADS="${5:-8}"
	READS="${6:-}"
	QC_STATS="${7:-0}"
	PREQC_STATS="${8:-1}"
	FASTP_PARAMS=(${9:--x -q 17 -u 15 -n 50 --length_required 2 -p}) # that's one -x
	HISAT_PARAMS=(--no-temp-splicesite --mm --new-summary --summary-file /dev/null -k 1 -p "${THREADS}")

	FASTP_EXTRACT="{summary:.summary|pick(.before_filtering,.after_filtering|.total_reads,.total_bases,.read1_mean_length,.gc_content),
	filtering_result:.filtering_result,
	adapter_cutting:.adapter_cutting,
	polyx_trimming:.polyx_trimming,
	duplication:.duplication,
	overrepresented:{before:[.read1_before_filtering.overrepresented_sequences|to_entries|sort_by(.value)|reverse|limit(5;.[])]|from_entries,
	after:[.read1_after_filtering.overrepresented_sequences|to_entries|sort_by(.value)|reverse|limit(5;.[])]|from_entries}}"
	#EX_ADP="--adapter_fasta fastp_adapters.fasta"

	# run fastp first for read stats and warm files
	if [[ "${QC_STATS}" -eq 1 ]]; then
		QC_FASTQ="${FASTQ}.fastp.fastq"
	else
		QC_FASTQ="/dev/null"
	fi
	fastp -w "${THREADS}" -i "${FASTQ}" -o "${QC_FASTQ}" -j "${FASTQ}.fastp.json" -h /dev/null "${FASTP_PARAMS[@]}"
	fastp_info=$(jq -c "${FASTP_EXTRACT}" "${FASTQ}.fastp.json")
	rm "${FASTQ}.fastp.json"

	READS="${READS:-$(<<<"${fastp_info}" jq ".filtering_result.passed_filter_reads")}"
	samfile="${FASTQ}.sam"
	counts_file="${FASTQ}.counts"
	counts_summary_file="${counts_file}.summary"
	samfile_qc="${FASTQ}.qc.sam"
	counts_file_qc="${FASTQ}.qc.counts"
	counts_summary_file_qc="${counts_file_qc}.summary"
	# run pre-qc hisat2
	if [[ "${PREQC_STATS}" -eq 1 ]]; then
		hisat2 -x "${HISAT2_INDEX}" -U "${FASTQ}" -S "${samfile}" "${HISAT_PARAMS[@]}" 2>/dev/null
	fi
	# possibly run post-qc hisat2
	if [[ "${QC_STATS}" -eq 1 ]]; then
		READS_AFTER=$(<<<"${fastp_info}" jq ".filtering_result.passed_filter_reads")
		hisat2 -x "${HISAT2_INDEX}" -U "${QC_FASTQ}" -S "${samfile_qc}" "${HISAT_PARAMS[@]}" 2>/dev/null
		rm -f "${QC_FASTQ}"
	fi

	# pre-qc featurecounts
	# consider -Q <num> quality threshold?
	featureCounts -a "${GTF}" -T "${THREADS}" -o "${counts_file}" "${samfile}" 1>/dev/null 2>/dev/null
	# parse output
	if [[ "${PREQC_STATS}" -eq 1 ]]; then
		out="$(json_kv raw "$(parse_mapping "${counts_file}" "${counts_summary_file}" "${READS}")")"
		rm -f "${samfile}" "${counts_file}" "${counts_summary_file}"
	fi
	if [[ "${QC_STATS}" -eq 1 ]]; then
		# post-qc featurecounts
		featureCounts -a "${GTF}" -T "${THREADS}" -o "${counts_file_qc}" "${samfile_qc}" 1>/dev/null 2>/dev/null
		out="${out},$(json_kv qc "$(parse_mapping "${counts_file_qc}" "${counts_summary_file_qc}" "${READS_AFTER}")")"
		rm -f "${samfile_qc}" "${counts_file_qc}" "${counts_summary_file_qc}"
	fi
	out="${out},$(json_kv fastp "${fastp_info}")"

	out=$(json_kv "mapping" "{${out}}")
	echo "${out}" 1>>"${OUTFILE}"
}

# https://gabrielstaples.com/bash-libraries/
if [[ "${BASH_SOURCE[0]}" = "$0" ]]; then
	if [[ "$#" -lt 3 ]]; then
		echo "Usage: $0 <FASTQ> <HISAT2_INDEX> <GTF> [OUTFILE] [THREADS] [READS] [QC_STATS] [RAW_STATS] [FASTP PARAMS]" 1>&2
	else
		mapping_main "$@"
	fi
else
	true
fi
