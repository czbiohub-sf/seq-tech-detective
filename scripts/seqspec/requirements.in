pyyaml

# Security floors for transitive deps flagged by Dependabot.
# seqspec pulls these in via requests / Bio.Entrez, but seqspec2detective.py
# only does local YAML parsing + region indexing and never exercises the
# vulnerable code paths (no HTTP, no Entrez XML). These floors resolve the
# alerts to patched versions without bumping seqspec itself.
