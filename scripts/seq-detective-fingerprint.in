#!/bin/bash

# module for running seq-detective fingerprint phase

set -e
SCRIPTDIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"

sum() {
	paste -sd+ - | sed 's/\+ $//' | bc
}

hit_sum() {
	echo "${1}" | cut -d'[' -f2 | cut -d']' -f1 | tr ',' '\n' | cut -d':' -f2 | sum
}
fp_hit_rate() {
	file="${1}"
	key="${2}"
	total_reads="${3}"

	hits=$(grep -P "${key}: \[.*\]" "${file}")
	fp_hit_sum=$(hit_sum "${hits}")
	fp_hit_sum=${fp_hit_sum:-0}
	echo "scale=5; ${fp_hit_sum} / ${total_reads}" | bc
}

fingerprint_header() {
	PRINT_HEADER="${2:-1}"
	# header line
	if [[ "${PRINT_HEADER}" -eq 1 ]]; then
		printf "spots\treadlen\t"
		printf "10x_v2\t10x_v2_rc\t10x_v3\t10x_v3_rc\t"
		printf "fp_indrop_bc1\tfp_indrop_bc1_rc\tfp_indrop_link\tfp_indrop_link_rc\tfp_indrop_bc2\tfp_indrop_bc2_rc\n"
	fi
}

# parse seq-detective fingerprint output
parse_fingerprint() {
	file="${1}"

	reads=$(grep -P "reads: \d+" "${file}" | cut -d' ' -f2)
	avglen=$(grep -P "avg len: \d+" "${file}" | cut -d' ' -f3)
	#polyt=$(grep -P "polyt hit rate" "${file}" | cut -d' ' -f1)
	# 10x
	fp_10x_v2=$(fp_hit_rate "${file}" "cb_10x_737K-august-2016.txt" "${reads}")
	fp_10x_v2_rc=$(fp_hit_rate "${file}" "cb_10x_737K-august-2016.txt_RC" "${reads}")
	#fp_10x_v3=$(fp_hit_rate "${file}" "cb_10x_737K-august-2016_v3.txt" "${reads}")
	#fp_10x_v3_rc=$(fp_hit_rate "${file}" "cb_10x_737K-august-2016_v3.txt_RC" "${reads}")
	# indrop
	fp_indrop_bc1=$(fp_hit_rate "${file}" "cb_indrop_bc1.txt" "${reads}")
	fp_indrop_bc1_rc=$(fp_hit_rate "${file}" "cb_indrop_bc1.txt_RC" "${reads}")
	fp_indrop_link=$(fp_hit_rate "${file}" "AAGGCGTCACAAGCAATCACTC" "${reads}")
	fp_indrop_link_rc=$(fp_hit_rate "${file}" "AAGGCGTCACAAGCAATCACTC_RC" "${reads}")
	fp_indrop_bc2=$(fp_hit_rate "${file}" "cb_indrop_bc2.txt" "${reads}")
	fp_indrop_bc2_rc=$(fp_hit_rate "${file}" "cb_indrop_bc2.txt_RC" "${reads}")

	{
		printf "%d\t%d\t" "${reads}" "${avglen}"
		printf "%.5f\t%.5f\t%.5f\t%.5f\t" "${fp_10x_v2}" "${fp_10x_v2_rc}" "${fp_10x_v3}" "${fp_10x_v3_rc}"
		printf "%.5f\t%.5f\t%.5f\t%.5f\t%.5f\t%.5f\n" "${fp_indrop_bc1}" "${fp_indrop_bc1_rc}" "${fp_indrop_link}" "${fp_indrop_link_rc}" "${fp_indrop_bc2}" "${fp_indrop_bc2_rc}"
	}
}

fingerprint_main() {
	set -e
	shopt -s inherit_errexit
	FASTQ="${1}"
	OUTFILE="${4:-/dev/stdout}"
	PRINT_HEADER="${5:-0}"

	SD_PARAMS=""
	fingerprintfile="${FASTQ}.fingerprint"

	# run sd
	"seq-detective-fp" "${1}" "${SD_PARAMS}" 1>"${fingerprintfile}"

	fingerprint_header "${PRINT_HEADER}" 1>>"${OUTFILE}"
	# mapping summary variables
	parse_fingerprint "${fingerprintfile}" 1>>"${OUTFILE}"
	# clean up intermediate files
	rm -f "${fingerprintfile}"
}

# https://gabrielstaples.com/bash-libraries/
if [[ "${BASH_SOURCE[0]}" = "$0" ]]; then
	if [[ "$#" -lt 1 ]]; then
		echo "Usage: $0 <FASTQ> [OUTFILE] [PRINT_HEADER]" >&2
	else
		fingerprint_main "$@"
	fi
else
	true
fi
