#!/bin/bash
#::version
#: seq-detective @VERSION@ (core)
#::help
#: seq-detective
#: interface for download an SRA accession and call all seq-detective phases
#: subcommands
#:    index         just download and create index[es] for phase 2 mapping
#:    download      download SRA using seq-detective rules
#:    fingerprint   run all seq-detective phases on specified fastq
#:    core          run mapping phase on specified fastq
#:    help          get command help
#::index
#: seq-detective index
#: download assembly and create hisat2 index[es] for phase 2 mapping
#:    usage: seq-detective index <assembly name>
#::download
#: seq-detective download
#: download SRA with a read limit using seq-detective rules (NOT IMPLEMENTED)
#:    usage: seq-detective download [-X limit] [-c threads] [-b] <ACCESSION> <types>
#:
#:    <types>       Original SRA upload semantic_name(s), e.g. "bam" or "fastq fastq fastq".
#:    [-X limit]    (2000000) Read limit.  set to <UNIMPLEMENTED> for no limit
#:    [-c threads]  (# cores) Threads to use (for sam/bam conversion)
#:    [-b]          (0) Use default SRA Toolkit behavior to omit (some) "technical" reads for pseudobulking.
#:
#:    Output: path(s) to FASTQ file(s), space separated
#::fingerprint
#::core
#: seq-detective core
#: run mapping phase and technical/biological judgement only on fastq matching <accession> prefix
#:    usage: seq-detective core <accession> <hisat2 index> <gtf> [<outfile>] [<threads>(8)] [<qc_stats>(0)] [<preqc_stats>(1)] ["<fastp_params>"]
#::judge
#: seq-detective judge
#: run seq-detective judge on scan result json
#:    usage: seq-detective judge [options] <file.json>
#::

set -e
COMMAND="${1}"
showhelp() {
	# enable printing when we see #::${1}, disable when we see #::
	sed -n "/#::${1}/,/#::/{//!{s/#: //p};}" "${BASH_SOURCE-$0}"
}

########
# determine supporting file location
# where is this script?
SCRIPTDIR=$(dirname $(readlink -f "${BASH_SOURCE-$0}"))
if [[ -e "${SCRIPTDIR}/../scripts/seq-detective-map" ]]; then
	# 1. if we look like a meson build directory, use that
	PKGBINDIR="${SCRIPTDIR}/"
	PKGDATADIR="$(readlink -m "${SCRIPTDIR}/../resources")/"
	PKGLIBDIR="$(readlink -m "${SCRIPTDIR}/../lib")/"
	PKGLIBEXECDIR="$(readlink -m "${SCRIPTDIR}/../scripts")/"
elif [[ -e "${SCRIPTDIR}/../libexec/seq-detective/seq-detective-map" ]]; then
	# 2. if we look like a "release" dir structure not installed, use local file structure
	PKGBINDIR="${SCRIPTDIR}/"
	PKGDATADIR="$(readlink -m "${SCRIPTDIR}/../share/seq-detective")/"
	PKGLIBDIR="$(readlink -m "${SCRIPTDIR}/../lib/seq-detective")/"
	PKGLIBEXECDIR="$(readlink -m "${SCRIPTDIR}/../libexec/seq-detective")/"
elif [[ -e "@PKGLIBEXECDIR@/seq-detective-map" ]]; then
	# 3. finally, try install prefix
	PKGBINDIR="@PKGBINDIR@/"
	PKGDATADIR="@PKGDATADIR@/"
	PKGLIBDIR="@PKGLIBDIR@/"
	PKGLIBEXECDIR="@PKGLIBEXECDIR@/"
fi
PATH="${SCRIPTDIR}:${PKGLIBEXECDIR}:$PATH"

PKGSTATEHOME="${XDG_STATE_HOME:-$HOME/.local/state}/seq-detective/"

########
# load in our "module" functions
. "${PKGLIBEXECDIR}seq-detective-fingerprint"
. "${PKGLIBEXECDIR}seq-detective-map"

###############################################################################

parse_named_reference() {
	set -e
	shopt -s inherit_errexit
	name="${2:-${1}}"
	while IFS='= ' read -r key value; do
		if [[ ! ${key} =~ "(FNA|GTF|HS2)" && -n ${value} ]]; then
			export ${key}="${value}"
		fi
	done <"${PKGSTATEHOME}/${name}"
}

index() {
	set -e
	shopt -s inherit_errexit
	name="${2:-${1}}"

	cached="${PKGSTATEHOME}/${name}"

	if [[ -f "${cached}" ]]; then
		parse_named_reference "${name}"
		if [[ -n "${FNA}" && -n "${GTF}" && -n "${HS2}" ]]; then
			echo "have existing reference for '${name}' in ${cached}" >&2
			echo "fna: ${FNA}"
			echo "gtf: ${GTF}"
			echo "${HS2}"
			return 0
		else
			echo "existing reference for '${name}' missing entries; rebuilding" >&2
			echo "(found FNA:${FNA} && GTF:${GTF} & HISAT2:${HS2})" >&2
		fi
	fi
	# download
	path=$("assembly-search" "${1}")
	# find important files
	fastaline=$(grep -e "\.fa\|\.fna\|\.fasta" "${path}/md5sum.txt")
	read -d '' -r _md5 fna <<<"${fastaline}" || true
	gtfline=$(grep -e "\.gtf" "${path}/md5sum.txt")
	read -d '' -r _md5 gtf <<<"${gtfline}" || true

	fna="${path}/${fna}"
	gtf="${path}/${gtf}"

	mkdir -p "${PKGSTATEHOME}"
	# build index
	echo "building hisat2 index"
	hs2=$("index-build" "${fna}" "${gtf}" "${3}" "${4}")

	printf "GTF=%s\nFNA=%s\nHS2=%s" "${gtf}" "${fna}" "${hs2}" >"${cached}"

	echo "fna: ${fna}"
	echo "gtf: ${gtf}"
	echo "${hs2}"
	return 0
}

# fingerprint
fingerprint() {
	set -e
	# TODO
	fingerprint-rough "$@"
}

# TODO: this function should be obliterated!
# Quick hack for results!
fingerprint-rough() {
	set -e
	FASTQ="${1}"
	HISAT2_INDEX="${2}"
	GTF="${3}"
	OUTFILE="${4:-/dev/stdout}"
	PRINT_HEADER="${5:-0}"
	HISAT2_THREADS="${6:-8}"
	USE_FASTP="${7:-0}"

	if [[ "${PRINT_HEADER}" -eq 1 ]]; then
		{
			printf "file\t"
			fingerprint_header "${PRINT_HEADER}"
		} 1>>"${OUTFILE}"
	fi

	# run seq-detective-fingerprint
	{
		printf "%s\t" "${FASTQ}"
		fingerprint_main "${FASTQ}" "${OUTFILE}" 0
	} 1>>"${OUTFILE}"
}

# format a json key-value pair
# $1: key
# $2: value
json_kv() {
	{
		printf "\"%s\": %s" "${1}" "${2}"
	}
}

# 1: filename
# 2: reads
# 3: readlen
# 4: arbitrary key-value pairs
json_wrap_fastq_core() {
	{
		printf "{"
		printf "\"name\":\"%s\"," "${1}"
		printf "\"reads\":%s," "${2}"
		printf "\"readlen\":%s," "${3}"
		printf "%s" "${4}"
		printf "}"
	}
}

core-map() {
	set -e
	FASTQ="${1}"
	HISAT2_INDEX="${2}"
	GTF="${3}"
	OUTFILE="${4:-/dev/stdout}"
	THREADS="${5:-8}"
	QC_STATS="${6:-0}"
	PREQC_STATS="${7:-1}"
	FASTP_PARAMS="${8:-}" # that's one -x
	FORMAT="${9:-json}"

	# get read length and number of reads directly from fastq since we don't run fingerprint
	readlen=$(awk 'NR==4{print length($0); exit}' "${FASTQ}")
	reads=$(($(wc -l "${FASTQ}" | cut -f1 -d' ') / 4))

	if [[ "${FORMAT}" == "json" ]]; then
		out="${out}$(mapping_main "${FASTQ}" "${HISAT2_INDEX}" "${GTF}" "${OUTFILE}" "${THREADS}" "${reads}" "${QC_STATS}" "${PREQC_STATS}" "${FASTP_PARAMS}")"
		out="$(json_wrap_fastq_core "${FASTQ}" "${reads}" "${readlen}" "${out}")"
	fi

	if [[ "${PRETTY_PRINT}" -eq 1 ]]; then
		echo "${out}" | jq '.' 1>>"${OUTFILE}"
	else
		echo "${out}" 1>>"${OUTFILE}"
	fi
}

core() {
	set -e
	# accession/file prefix, reference prefix, gtf
	PREFIX="${1}"
	HISAT2_INDEX="${2}"
	GTF="${3}"
	OUTFILE="${4:-/dev/stdout}"
	THREADS="${5:-8}"
	QC_STATS="${6:-0}"
	PREQC_STATS="${7:-1}"
	FASTP_PARAMS="${8:-}" # that's one -x
	FORMAT="${9:-json}"

	json="{\"accession\": \"${PREFIX}\","
	json="${json}\"readfiles\": [${NL}"
	first=1
	files=$(ls "${PREFIX}"*.f*q 2>/dev/null)
	for file in ${files}; do
		# array item per file
		[ ${first} -ne 1 ] && json="${json},${NL}"
		f_res=$(core-map "${file}" "${HISAT2_INDEX}" "${GTF}" "${OUTFILE}" "${THREADS}" "${QC_STATS}" "${PREQC_STATS}" "${FASTP_PARAMS}" "${FORMAT}")
		json="${json}${f_res}"
		rm "${file}"
		first=0
	done
	# close accession block
	if [ "${idx}" -lt "${END}" ]; then
		json="${json}${NL}]},${NL}"
	else
		json="${json}${NL}]}${NL}"
	fi
	echo "${json}" 1>>"${OUTFILE}"
}
#::version

# TODO: need option parsing! (--json)
# (if any -h, command is "help" and $COMMAND is the next argument)

# switch based on COMMAND
case "${COMMAND}" in
"index")
	shift 1 # shift off subcommand
	# query, nickname, threads, NOANNOTATIONS
	index "$@"
	;;
"download")
	shift 1 # shift off subcommand
	"seq-detective-download" "$@"
	;;
"fingerprint")
	# file, reference prefix, gtf
	fingerprint-rough "${2}" "${3}" "${4}"
	;;
"fingerprint-rough")
	# file, reference prefix, gtf
	fingerprint-rough "${2}" "${3}" "${4}"
	;;
"core-map")
	# file, reference prefix, gtf
	# (file, hisat2 index prefix, gtf, outfile, threads, qc_stats, raw_stats, fastp_params)
	shift 1 # shift off subcommand
	core-map "$@"
	;;
"judge")
	# json file
	shift 1 # shift off subcommand
	judge.py "$@"
	;;
"core")
	# accession prefix, reference prefix, gtf
	shift 1 # shift off subcommand
	# core-map -> judge pipeline
	core "$@"
	;;
"help" | -h)
	showhelp "${2:-help}"
	;;
*)
	echo "unknown command: ${COMMAND}"
	showhelp "help"
	exit 1
	;;
esac

