#!/bin/bash
#::help
#: seq-detective
#: interface for download an SRA accession and call all seq-detective phases
#: subcommands
#:    index         just download and create index[es] for phase 2 mapping
#:    download      download SRA using seq-detective rules
#:    fingerprint   run all seq-detective phases on specified fastq
#:    core          run mapping phase on specified fastq
#:    help          get command help
#::index
#: seq-detective index
#: download assembly and create hisat2 index[es] for phase 2 mapping
#:    usage: seq-detective index <assembly name>
#::download
#: seq-detective download
#: download SRA using seq-detective rules (not implemented)
#::fingerprint
#::core
#: seq-detective core
#: run mapping phase and technical/biological judgement only on specified fastq
#:    usage: seq-detective core <fastq> <hisat2 index> <gtf>
#::

set -e
# index help
COMMAND="${1}"
showhelp() {
	# enable printing when we see #::${1}, disable when we see #::
	sed -n "/#::${1}/,/#::/{//!{s/#: //p};}" "${BASH_SOURCE-$0}"
}

# gnu readlink only
SCRIPTDIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
# load in our "module" functions
. "${SCRIPTDIR}/seq-detective-fingerprint"
. "${SCRIPTDIR}/seq-detective-map"

index() {
	set -e
	# download
	path=$("${SCRIPTDIR}/bin/scripts/assembly-search" "${1}")
	# find important files
	ls "${path}"
	fastaline=$(grep -e "\.fa\|\.fna\|\.fasta" "${path}/md5sum.txt")
	read -d '' -r _md5 fasta <<<"${fastaline}" || true
	gtfline=$(grep -e "\.gtf" "${path}/md5sum.txt")
	read -d '' -r _md5 gtf <<<"${gtfline}" || true

	echo "fasta: ${fasta}"
	echo "gtf: ${gtf}"
	# build index
	set -x
	"${SCRIPTDIR}/bin/scripts/index-build" "${path}/${fasta}" "${path}/${gtf}"
	return 0
}

# fingerprint
# download SRA with fasterq-dump, then call seq-detective and hisat2
# arguments: SRA accession, reference genome path
fingerprint() {
	set -e
	# TODO
	fingerprint-rough "$@"
}

# TODO: this function should be obliterated!
# Quick hack for results!
fingerprint-rough() {
	set -e
	FASTQ="${1}"
	HISAT2_INDEX="${2}"
	GTF="${3}"
	OUTFILE="${4:-/dev/stdout}"
	PRINT_HEADER="${5:-0}"
	HISAT2_THREADS="${6:-8}"
	USE_FASTP="${7:-0}"

	if [ "${PRINT_HEADER}" -eq 1 ]; then
		{
			printf "file\t"
			fingerprint_header "${PRINT_HEADER}"
			mapping_header "${PRINT_HEADER}" "${USE_FASTP}"
		} 1>>"${OUTFILE}"
	fi

	# run seq-detective, hisat2, and featureCounts
	{
		printf "%s\t" "${FASTQ}"
		fingerprint_main "${FASTQ}" "${OUTFILE}" 0
		mapping_main "${FASTQ}" "${HISAT2_INDEX}" "${GTF}" "${OUTFILE}" 0 "${HISAT2_THREADS}" "${USE_FASTP}"
	} 1>>"${OUTFILE}"
}

core() {
	set -ex
	FASTQ="${1}"
	HISAT2_INDEX="${2}"
	GTF="${3}"
	OUTFILE="${4:-/dev/stdout}"
	PRINT_HEADER="${5:-0}"
	HISAT2_THREADS="${6:-8}"
	USE_FASTP="${7:-0}"

	if [ "${PRINT_HEADER}" -eq 1 ]; then
		{
			printf "file\t"
			printf "reads\treadlen\t"
			mapping_header "${PRINT_HEADER}" "${USE_FASTP}"
		} 1>>"${OUTFILE}"
	fi

	# get read length and number of reads directly from fastq since we don't run fingerprint
	readlen=$(awk 'NR==4{print length($0); exit}' "${FASTQ}")
	reads=$(wc -l "${FASTQ}" | cut -f1 -d' ')
	{
		printf "%s\t" "${FASTQ}"
		printf "%d\t%d\t" "${reads}" "${readlen}"
		mapping_main "${FASTQ}" "${HISAT2_INDEX}" "${GTF}" "${OUTFILE}" 0 "${HISAT2_THREADS}" "${USE_FASTP}" "${reads}"
	} 1>>"${OUTFILE}"
}

# TODO: need option parsing! (--json, --header)
# (if any -h, command is "help" and $COMMAND is the next argument)

# switch based on COMMAND
case "${COMMAND}" in
"index")
	# reference name (common or accession)
	index "${2}"
	;;
"fingerprint")
	# file, reference prefix, gtf
	fingerprint-rough "${2}" "${3}" "${4}"
	;;
"fingerprint-rough")
	# file, reference prefix, gtf
	fingerprint-rough "${2}" "${3}" "${4}"
	;;
"core")
	# file, reference prefix, gtf
	core "${2}" "${3}" "${4}"
	;;
"help" | -h)
	showhelp "${2:-help}"
	;;
*)
	echo "unknown command: ${COMMAND}"
	showhelp "help"
	exit 1
	;;
esac
