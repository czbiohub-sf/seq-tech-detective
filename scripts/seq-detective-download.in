#!/bin/bash
#::help
#: seq-detective-download @VERSION@
#: module for downloading an SRA accession with a read limit.  for internal use only.
#:    usage: seq-detective-download [-X limit] [-c threads] [-b] <ACCESSION> <types>
#:
#:    <types>       Original SRA upload semantic_name(s), e.g. "bam" or "fastq fastq fastq".
#:    [-X limit]    (2000000) Read limit.  set to <UNIMPLEMENTED> for no limit
#:    [-c threads]  (# cores) Threads to use (for sam/bam conversion)
#:    [-b]          (0) Use default SRA Toolkit behavior to omit (some) "technical" reads for pseudobulking.
#:
#:    Output: path(s) to FASTQ file(s), space separated
#::

set -e
shopt -s nullglob

showhelp() {
	sed -n "/#::${1}/,/#::/{//!{s/#: //p};}" "${BASH_SOURCE-$0}"
}

types=""
bio_only="0"
LIMIT="200000"
cpus="$(nproc)"

while getopts ":t:X:c:bh" opt; do
	case "${opt}" in
	t) types="${OPTARG}" ;; # deprecated original types option syntax
	X) LIMIT="${OPTARG}" ;;
	c) cpus="${OPTARG}" ;;
	b) bio_only=1 ;;
	h)
		showhelp "help"
		exit 0
		;;
	*)
		showhelp "help"
		exit 1
		;;
	esac
done
shift $((OPTIND - 1))
ACCESSION="${1}"
types="${2:-types}"

sam2fastq_cpus=$((cpus - 4))
[[ "${sam2fastq_cpus}" -lt 1 ]] && sam2fastq_cpus=1

fastqdumpwithlimit() {
	ACC=$1
	LIMIT=$2
	fastq-dump --split-3 "${ACC}" -X "${LIMIT}" 1>&2
	files=("${ACC}"*.fastq)
	echo "${files[@]}"
}

samdumpwithlimit() {
	ACC=$1
	LIMIT=$(($2 * 4))
	SAMPIPE="${ACC}.$$.sampipe"
	FASTQ1TEMP="${ACC}_1.$$.fastq.down"
	FASTQ2TEMP="${ACC}_2.$$.fastq.down"
	FASTQ0TEMP="${ACC}.$$.fastq.down"
	FASTQXTEMP="${ACC}_X.$$.fastq.down"

	# what do accessions put in 0?  having them write to same stream messes up SRR24239717
	sam2fastq_param=(-@ "${sam2fastq_cpus}" -1 "${FASTQ1TEMP}" -2 "${FASTQ2TEMP}" -0 "${FASTQ0TEMP}" -s "${FASTQXTEMP}")
	mate1_lines=0
	mate2_lines=0
	single_lines=0
	single_lines_2=0

	rm -f "${SAMPIPE}" "${FASTQ1TEMP}" "${FASTQ2TEMP}" "${FASTQ0TEMP}" "${FASTQXTEMP}"
	mkfifo "${SAMPIPE}"
	sam-dump -u "${ACC}" | head -n $(($2 + 4000)) | samtools sort -n >"${SAMPIPE}" &
	samdump_pid=$!
	# mates must be namesorted or fastq conversion doesn't work.  keep a sorting buffer only as long as we need.
	samtools fastq "${SAMPIPE}" "${sam2fastq_param[@]}" -T CB,UB,QX,CR,BC,QT &
	samtools_pid=$!
	#echo "sam-dump pid: ${samdump_pid} ${samtools_pid}" 1>&2

	while true; do
		[[ -e "${FASTQXTEMP}" ]] && single_lines=$(wc -l "${FASTQXTEMP}" | cut -d' ' -f1)
		if [[ "${single_lines}" -ge "${LIMIT}" ]]; then
			kill "${samdump_pid}" "${samtools_pid}" 2>/dev/null || true
			head -n "${LIMIT}" "${FASTQXTEMP}" >"${ACC}.fastq"
			break
		fi
		[[ -e "${FASTQ0TEMP}" ]] && single_lines=$(wc -l "${FASTQ0TEMP}" | cut -d' ' -f1)
		if [[ "${single_lines}" -ge "${LIMIT}" ]]; then
			kill "${samdump_pid}" "${samtools_pid}" 2>/dev/null || true
			head -n "${LIMIT}" "${FASTQ0TEMP}" >"${ACC}.fastq"
			break
		fi
		[[ -e "${FASTQ1TEMP}" ]] && mate1_lines=$(wc -l "${FASTQ1TEMP}" | cut -d' ' -f1)
		[[ -e "${FASTQ2TEMP}" ]] && mate2_lines=$(wc -l "${FASTQ2TEMP}" | cut -d' ' -f1)
		if [[ ("${mate1_lines}" -ge "${LIMIT}") && ("${mate2_lines}" -ge "${LIMIT}") ]]; then
			kill "${samdump_pid}" "${samtools_pid}" 2>/dev/null || true
			head -n "${LIMIT}" "${FASTQ1TEMP}" >"${ACC}_1.fastq" &
			head1pid=$!
			head -n "${LIMIT}" "${FASTQ2TEMP}" >"${ACC}_2.fastq" &
			head2pid=$!
			wait "${head1pid}" "${head2pid}"
			break
		fi
		if [[ ! -e "/proc/${samdump_pid}" ]]; then
			kill "${samtools_pid}" 2>/dev/null || true
			# could still have valid result under the limit to return
			# first decide a winner for unmated/singlet reads
			[[ -e "${FASTQXTEMP}" ]] && single_lines_2=$(wc -l "${FASTQXTEMP}" | cut -d' ' -f1)
			if [[ "${single_lines_2}" -ge "${single_lines}" ]]; then
				single_lines="${single_lines_2}"
				head -n "${LIMIT}" "${FASTQXTEMP}" >"${ACC}.fastq" &
				head0pid=$!
			else
				head -n "${LIMIT}" "${FASTQ0TEMP}" >"${ACC}.fastq" &
				head0pid=$!
			fi
			head -n "${LIMIT}" "${FASTQ1TEMP}" >"${ACC}_1.fastq" &
			head1pid=$!
			head -n "${LIMIT}" "${FASTQ2TEMP}" >"${ACC}_2.fastq" &
			head2pid=$!
			wait "${head0pid}" "${head1pid}" "${head2pid}"
			break
		fi
		sleep 1
	done
	kill "${samdump_pid}" "${samtools_pid}" 2>/dev/null || true

	rm "${SAMPIPE}" "${FASTQ1TEMP}" "${FASTQ2TEMP}" "${FASTQ0TEMP}" "${FASTQXTEMP}"
	# RETURNED MATES COULD BE LESS THAN LIMIT!
	# so find out if mates have more reads
	if [[ "${mate2_lines}" -ge "${single_lines}" ]]; then
		rm -f "${ACC}.fastq"
		echo "${ACC}_1.fastq" "${ACC}_2.fastq"
	else
		rm -f "${ACC}_1.fastq" "${ACC}_2.fastq"
		echo "${ACC}.fastq"
	fi
}

if [[ "${bio_only}" -eq 1 ]]; then
	if [[ "${types}" == *"fastq"* ]]; then
		# one or more fastq mates, eg SRR24043286
		fastqdumpwithlimit "${ACCESSION}" "${LIMIT}"
	elif [[ "${types}" == *"10X Genomics bam file"* ]]; then
		# 10X Genomics bam file, eg SRR17117610
		# seq-detective doesn't try to handle 10x genomics bam files with bc in tags
		samdumpwithlimit "${ACCESSION}" "${LIMIT}"
	elif [[ "${types}" == *"bam"* ]]; then
		# bam file, eg ERR1251894
		samdumpwithlimit "${ACCESSION}" "${LIMIT}"
	elif [[ "${types}" == *"cram"* ]]; then
		# cram file, eg ERR2788340
		samdumpwithlimit "${ACCESSION}" "${LIMIT}"
	else
		# unknown file type, try dumping as fastq
		echo "Unknown file type: ${types}" 1>&2
		fastqdumpwithlimit "${ACCESSION}" "${LIMIT}"
	fi
else
	echo "single-cell technical dumping is not yet implemented" 1>&2
	exit 1
fi
