#!/bin/bash

set -e
HL_ON=$(tput setaf 3)
HL_OFF=$(tput sgr0)
INFO_ON=$(tput setaf 6)
INFO_OFF=$(tput sgr0)
ERR_ON=$(tput setaf 1)
ERR_OFF=$(tput sgr0)

FASTA="${1}"
GTF="${2}"
NUMTHREADS=8
NOANNOTATIONS=0
NAME="${FASTA##*/}"
NAME="hisat2-index/${NAME%.*}"

HISAT_PARAMS="--quiet --justref -p ${NUMTHREADS}"
if [[ ! -x "$(command -v hisat2-build)" ]]; then
  echo "${ERR_ON}hisat2-build not found: install hisat2${ERR_OFF}" >&2
  exit 1
fi

if [[ -z ${NOANNOTATIONS} ]]; then
    hisat2-build ${HISAT_PARAMS} "${FASTA}" "${NAME}"
else
    hisat2_extract_splice_sites.py "${GTF}" > genome.ss
    hisat2_extract_exons.py "${GTF}" > genome.exon
    hisat2-build ${HISAT_PARAMS } "${FASTA}" --exon genome.exon --ss genome.ss "${NAME}"
fi
echo "${NAME}"