#!/bin/bash
# workaround found in pacman's scripts/meson.build script configuration
# https://github.com/ezamlinsky/pacman/blob/master/build-aux/edit-script.sh.in

input=$1
output=$2

sed \
  -e "s|@LOG_USE_COLOR[@]|@LOG_USE_COLOR@|g" \
  -e "s|@PACKAGE_NAME[@]|@PACKAGE_NAME@|g" \
  -e "s|@VERSION[@]|@VERSION@|g" \
  -e "s|@PKGDATADIR[@]|@PKGDATADIR@|g" \
  -e "s|@PKGLIBDIR[@]|@PKGLIBDIR@|g" \
  -e "s|@PKGLIBEXECDIR[@]|@PKGLIBEXECDIR@|g" \
  -e "s|@PKGVARLIBDIR[@]|@PKGVARLIBDIR@|g" \
  -e "s|@PKGVARCACHEDIR[@]|@PKGVARCACHEDIR@|g" \
  -e "s|@configure_input[@]|Generated from ${input##*/}; do not edit by hand.|g" \
  "$input" >"$output"
